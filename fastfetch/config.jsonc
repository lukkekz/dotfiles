{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "modules": [
        "break",
        "os",
        "kernel",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
    ],
    "logo": {
        "type": "auto",
        "source": "~/Downloads/Cachyos-Logo.png",
        "width": 18,
        "height": 8
    },
    "display": {
        "key": {
            "type": "icon"
        },
        "color": {
            "keys": "blue",
            "output": "white"
        }
    }
}
